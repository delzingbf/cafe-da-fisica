# Copy to `.env`. Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_da_fisica
# Database used by `npm run test:int` and `npm run test:e2e` (created by db/init on first boot).
# Only read by the Vitest configs, never by the API itself.
TEST_DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_da_fisica_test
# Origin allowed by CORS (the Vite dev server). Not needed when going through the Vite proxy.
CORS_ORIGIN=http://localhost:5173
# Resend (https://resend.com/api-keys). Leave empty in development: emails are logged instead of sent.
# Required when NODE_ENV=production.
RESEND_API_KEY=
# Sender shown on outgoing emails. onboarding@resend.dev works without a verified domain, but only
# delivers to the email of your own Resend account; use an address on your verified domain for real use.
EMAIL_FROM=Café da Física <onboarding@resend.dev>
