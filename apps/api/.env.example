# Copy to `.env`. Validated at startup by src/infrastructure/config/env.ts.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_da_fisica
# Database used by `npm run test:int` and `npm run test:e2e` (created by db/init on first boot).
# Only read by the Vitest configs, never by the API itself.
TEST_DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_da_fisica_test
# Origin allowed by CORS (the Vite dev server). Not needed when going through the Vite proxy.
CORS_ORIGIN=http://localhost:5173
# Outgoing email over SMTP, Gmail by default. Leave SMTP_USER and SMTP_PASSWORD empty in
# development: emails are logged instead of sent. Both are required when NODE_ENV=production.
# For Gmail, SMTP_PASSWORD is an app password, not the account password: turn on 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords (16 letters).
SMTP_HOST=smtp.gmail.com
# 465 (TLS) or 587 (STARTTLS).
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender shown on outgoing emails. Gmail always sends as SMTP_USER, so only the name can change.
# Leave empty for "Café da Física <SMTP_USER>".
EMAIL_FROM=
# Signs the admin session cookie (at least 32 characters). Leave empty in development to use a
# built-in development secret. Required when NODE_ENV=production; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
