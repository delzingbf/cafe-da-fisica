{
  "name": "cafe-da-fisica",
  "version": "0.0.1",
  "private": true,
  "description": "Café da Física — NestJS API, React (Vite) web client and PostgreSQL database in one repository",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n shared,api,web -c magenta,blue,green \"npm run dev -w packages/shared\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/api",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:studio": "npm run db:studio -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2"
  }
}
